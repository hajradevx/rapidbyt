# Session secret — generate a random 32+ char string
NUXT_SESSION_PASSWORD=

# Resend email API key — https://resend.com/dashboard/api-keys
NUXT_RESEND_API_KEY=

# Google PageSpeed Insights API key — also used for Chrome UX Report (CrUX) History API
# https://developers.google.com/speed/docs/insights/v5/get-started
# Same key works for: PageSpeed Insights + CrUX daily API + CrUX History API
NUXT_PAGESPEED_API_KEY=
