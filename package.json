{
  "name": "rapidbyt",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "node -e \"import('fs').then(fs=>fs.rmSync('.nuxt',{recursive:true,force:true})).catch(()=>{})\" && nuxt prepare",
    "db:generate": "nuxt db generate",
    "db:migrate": "wrangler d1 migrations apply DB",
    "db:migrate-remote": "wrangler d1 migrations apply DB --remote",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "vp config"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@nuxt/content": "3.16.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^1.1.0",
    "@nuxt/image": "^2.2.0",
    "@nuxt/ui": "^4.12.0",
    "@nuxthub/core": "^0.10.11",
    "@nuxtjs/seo": "6.0.1",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "nuxt": "^4.6.2",
    "nuxt-auth-utils": "0.5.29",
    "resend": "^6.34.1",
    "uuid": "^14.0.3",
    "vue": "^3.6.0-rc.13",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.152.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
